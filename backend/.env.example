PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/edtech
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Admin seed script (npm run seed:admin)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@edtech.com
ADMIN_PASSWORD=Admin@12345

# AWS Configuration for Amazon Translate
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=EduLearn
EMAIL_FROM_ADDRESS=noreply@edulearn.local

CLIENT_URL=http://localhost:5173
